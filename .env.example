# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qirtas_dev

# Logging
LOG_LEVEL=info

# Browser origins allowed to call this API (comma-separated, no spaces).
# Empty — the default — denies every cross-origin BROWSER request.
# The mobile app is unaffected either way: CORS is a browser mechanism and
# native HTTP clients ignore it. Set this only when a web build or a
# browser-based admin panel exists.
# ALLOWED_ORIGINS=https://admin.qirtas.sy,https://qirtas.sy

# ⚠️ Behind a reverse proxy / load balancer, Express's `trust proxy` MUST be
# enabled (app.ts) — otherwise every request resolves to the proxy's own IP and
# both rate limiters collapse into one shared bucket for all clients.

# ─────────────────────────────────────────────────────────────────────────────
# Mail transport  (core/auth/adapters/smtp-email-sender.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Switching provider is a change to THESE VALUES AND NOTHING ELSE — both speak
# SMTP, so no code changes when the mail server does:
#
#   organisation webmail   SMTP_HOST=webmail.mow.gov.sy  SMTP_PORT=465  SMTP_SECURE=true
#   Gmail                  SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  SMTP_SECURE=false
#
# SMTP_SECURE=true  → implicit TLS (port 465)
# SMTP_SECURE=false → STARTTLS     (port 587); nodemailer upgrades automatically
#
# Leaving SMTP_HOST empty selects the development log adapter, which writes
# codes to the server log in development and REFUSES to do so in production —
# so a forgotten configuration fails loudly instead of leaking codes into logs.
# SMTP_HOST=webmail.mow.gov.sy
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@mow.gov.sy
# SMTP_PASS=
# MAIL_FROM=Qirtas <no-reply@mow.gov.sy>
# MAIL_TRANSPORT=auto        # auto (default) | smtp | log

# ─────────────────────────────────────────────────────────────────────────────
# Authentication policy  (core/auth/config/auth-config.ts)
# ─────────────────────────────────────────────────────────────────────────────
# off      — no verification; accounts are created already verified
# optional — codes are issued and verifiable, nothing is gated on it
# required — a registration stays at `pending_verification` and does NOT enter
#            the admin review queue until the address is proven. This is what
#            keeps that queue un-floodable by addresses nobody owns.
#
# Defaults to `off` so an existing deployment that upgrades without configuring
# SMTP keeps behaving exactly as before. Qirtas sets `required`.
EMAIL_VERIFICATION_MODE=required
# EMAIL_VERIFICATION_TTL_MINUTES=15
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5              # per CODE, survives IP rotation
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# PASSWORD_RESET_TTL_MINUTES=15
# PASSWORD_RESET_MAX_ATTEMPTS=5
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# Length is the knob worth tuning; the composition rules (one letter, one digit)
# are fixed in auth-config.ts — see that file for why symbol-class requirements
# are deliberately absent.
# PASSWORD_MIN_LENGTH=8

# Sessions. The idle timeout slides forward with use; the absolute one does not,
# and is what bounds a token stolen from a device that polls in the background.
# SESSION_IDLE_TIMEOUT_MINUTES=10080   # 7 days
# SESSION_ABSOLUTE_TIMEOUT_DAYS=30
# SESSION_ROTATE_AFTER_HOURS=24        # age at which POST /auth/refresh re-mints

# First Super Admin created by `npm run db:seed -- --admin` (and `npm run db:setup`).
# All optional — these are the defaults. Local development only; never point a
# publicly reachable environment at them.
# The email must NOT end with @qirtas.test — that suffix is hard-deleted by `--demo --reset`.
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Qirtas
# SEED_ADMIN_EMAIL=super_admin@admin.com
# SEED_ADMIN_PHONE=0900000000
# SEED_ADMIN_PASSWORD=P@ssw0rd@123
